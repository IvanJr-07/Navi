# Copia este archivo como ".env" y llena tus datos.
# ¡Nunca subas el archivo .env a GitHub ni pegues las claves en ningún lado!
# En GitHub, estos mismos datos van en Settings → Secrets and variables → Actions.

# --- Telegram ---
TELEGRAM_TOKEN=pega_aqui_el_token_de_BotFather
TELEGRAM_CHAT_ID=pega_aqui_tu_chat_id

# --- IA ---
# Proveedor que usa Navi: gemini o claude
IA_PROVEEDOR=gemini
GEMINI_API_KEY=pega_aqui_tu_clave_de_Google_AI_Studio
# Modelos en orden de preferencia (si uno falla, prueba el siguiente)
GEMINI_MODELO=gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-3.8-flash

# Solo si algún día usas Claude:
# ANTHROPIC_API_KEY=

# --- Perfil de gustos ---
# En tu PC, Navi lee el archivo intereses.yaml (no se sube a GitHub).
# En la nube, su contenido completo va en el secreto INTERESES.
